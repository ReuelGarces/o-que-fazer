{
  "name": "oquefazer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/start.ts",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/setup.ts",
    "db:backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/backup.ts",
    "db:generate": "drizzle-kit generate",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/http.integration.ts",
    "test:docker": "node --test tests/docker.smoke.mjs",
    "test:ui": "node --conditions=react-server --import tsx --test tests/browser.e2e.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "better-sqlite3": "^13.1.1",
    "clsx": "^2.1.1",
    "dicons": "^1.1.7",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.1.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
