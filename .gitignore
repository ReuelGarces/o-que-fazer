# ==========================================
# O QUE FAZER? - Git Ignore
# Next.js + TypeScript + SQLite + Drizzle
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/.nyc_output

# Next.js
/.next/
/out/

# Production
/build
/dist

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example

# SQLite databases
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Local database storage
/data/
/backups/

# Temporary files
/tmp/
/temp/
*.tmp
*.temp

# Vercel
.vercel

# Coolify local configuration
.coolify/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE and editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Security
*.pem
*.key
*.p12
*.pfx

# Local configuration
*.local

# Estado de execução local do Impeccable
.impeccable/live/

# ==========================================
# IMPORTANT:
# Do not ignore:
#
# drizzle/
# drizzle.config.ts
# src/
# app/
# components/
# public/
# package.json
# package-lock.json
# next.config.ts
# .env.example
#
# These files should be versioned.
# ==========================================