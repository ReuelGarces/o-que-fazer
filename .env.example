# Use caminhos absolutos fora do repositório. Exemplo local Linux:
# SQLITE_PATH=/home/seu-usuario/.local/share/oquefazer/database.sqlite
# Exemplo Windows (PowerShell: $env:SQLITE_PATH=...):
# SQLITE_PATH=C:/Users/seu-usuario/AppData/Local/oquefazer/database.sqlite
SQLITE_PATH=/var/lib/sqlite/database.sqlite
# Gere um segredo aleatório com pelo menos 32 caracteres. Não compartilhe.
SESSION_SECRET=
# Origem pública exata. HTTPS obrigatório em produção.
APP_ORIGIN=http://localhost:3000
# Apenas para db:backup, use um arquivo novo:
# SQLITE_BACKUP_PATH=/seus-backups/oquefazer-2026-11-13.sqlite
# Setup não interativo opcional: senha somente em arquivo secreto protegido.
# SETUP_PASSWORD_FILE=/run/secrets/initial_password
# SETUP_USERNAME=
# SETUP_PROFILE_1=
# SETUP_PROFILE_2=
